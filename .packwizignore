# packwiz does NOT read .gitignore -- this file is what keeps the index clean.
# Anything indexed here is downloaded by every client, so this list is what stops
# repo scaffolding from shipping as pack content.

# Prism instance-zip tooling. This ships the pack TO clients; it must never be
# indexed as part OF the pack, or every client downloads the installer scaffolding.
/deploy/

# Server install and export output -- reproducible, never distributed.
/server/
/build/
# Root-anchored: an export lands in the pack root, but a bundled resourcepack is
# also a .zip and must stay indexed.
/*.mrpack
/*.zip

# Repo metadata, not game files.
/.git/
/.github/
/.gitignore
/.packwizignore
/.claude/
/README.md
/MODS.md
/LICENSE

# Placeholders that keep empty folders in git. They are not pack content.
.gitkeep

# Runtime junk that can appear in a dev instance.
logs/
crash-reports/
saves/
screenshots/
*.log

# ProbeJS generated typings -- tens of MB of editor autocomplete data, regenerated
# in-game per install. Must never be indexed or it ships to every client.
/kubejs/probe/
/kubejs/typings/
/kubejs/jsconfig.json
/kubejs/README.txt

# Maintainer tooling. Ships the pack, is not part OF the pack.
/scripts/

# Default Options writes this per-install to track first-run state; shipping it
# would make every client think defaults were already applied.
defaultoptions.journal.json

# Cygwin/MSYS crash dumps. A segfaulting grep drops these in the pack root;
# they are gitignored, so indexing one makes every client 404 on a file that was
# never pushed.
*.stackdump

# Maintainer tooling (RegionScanner). Ships nothing to clients.
/tools/

# Bootstrap self-download; tooling, never pack content.
/packwiz-installer.jar
