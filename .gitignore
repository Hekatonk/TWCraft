# packwiz export output
/build/
*.mrpack

# Prism instance-zip build output. The zip is a release asset, not source, and the
# cached bootstrap jar is re-downloaded on demand. The scripts under deploy/ ARE
# tracked -- only their output is not.
/deploy/out/
/deploy/packwiz-installer-bootstrap.jar
*.zip
# ...but a bundled resourcepack/shaderpack IS a .zip and is real pack content.
# Without these, dropping one in would be silently untracked while packwiz happily
# indexes it, and clients would 404 on a file that never reached the repo.
!/resourcepacks/*.zip
!/shaderpacks/*.zip

# local test instance / runtime junk
/run/
/instance/
logs/
crash-reports/
saves/
screenshots/
*.log
# Cygwin/MSYS crash dumps -- a segfaulting grep leaves these in the cwd.
*.stackdump

# The server is never distributed -- it is run from a single machine and is fully
# reproducible from the pack itself (packwiz-installer syncs it).
/server/

# ProbeJS generated typings (regenerated in-game, huge, not source)
/kubejs/probe/
/kubejs/typings/
/kubejs/jsconfig.json

.vscode/
.idea/

# Default Options first-run tracker -- the mod's README says never to ship it.
defaultoptions.journal.json

# RegionScanner binary for generating JER worldgen data. A tool we run, not
# pack content -- and a 3 MB exe has no business in git.
/tools/

# The bootstrap self-downloads packwiz-installer.jar into whatever directory
# it runs from. That is tooling, not pack content.
/packwiz-installer.jar
